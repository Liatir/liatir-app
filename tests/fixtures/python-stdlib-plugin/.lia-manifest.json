{
  "name": "Python Stdlib Fixture",
  "version": "1.0.0",
  "description": "Fixture plugin that uses only the Python standard library.",
  "runtime": "python",
  "category": "Tests",
  "tags": ["python", "fixture"],
  "inputSchema": {
    "text": {
      "type": "string",
      "label": "Text",
      "description": "Text to analyze.",
      "required": true,
      "default": "hello from Liatir"
    }
  },
  "outputSchema": {
    "length": {
      "type": "number",
      "label": "Length",
      "description": "Number of characters in the input text.",
      "format": "integer"
    },
    "words": {
      "type": "number",
      "label": "Words",
      "description": "Number of whitespace-delimited words.",
      "format": "integer"
    },
    "summary": {
      "type": "json",
      "label": "Summary",
      "description": "Simple JSON summary generated by Python."
    }
  },
  "python": {
    "entry": "src/main.py",
    "pythonRequirement": {
      "minVersion": "3.10",
      "maxVersionExclusive": "3.14",
      "label": "Python >=3.10,<3.14"
    },
    "packages": [],
    "requirements": []
  }
}
