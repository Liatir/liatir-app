{
  "name": "liatir-cli",
  "version": "1.0.0",
  "description": "CLI for developing and building .liatir scripts",
  "bin": {
    "liatir": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-executable.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
