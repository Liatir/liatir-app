{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate:quenta": "node ../scripts/build-quenta-docs.mjs knowledge --out frontend/src/lib/quenta/generated/quenta-knowledge.generated.ts && node ../scripts/build-quenta-docs.mjs docs --out frontend/src/lib/quenta/generated/quenta-docs.generated.ts",
		"predev": "npm run generate:quenta && node ../scripts/build-single-cell-showcase.mjs",
		"dev": "vite dev",
		"prebuild": "npm run generate:quenta && node ../scripts/build-single-cell-showcase.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p stage-kit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.2"
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-python": "^6.2.1",
		"@iconify-json/lucide": "^1.2.114",
		"@iconify/svelte": "^5.2.2",
		"@sgratzl/chartjs-chart-boxplot": "^4.4.5",
		"@sveltejs/adapter-static": "^3.0.10",
		"@tailwindcss/browser": "^4.3.5",
		"@tailwindcss/vite": "^4.1.17",
		"@tauri-apps/api": "^2.11.0",
		"@xyflow/svelte": "^1.6.0",
		"chart.js": "^4.6.1",
		"chartjs-chart-matrix": "^3.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"lucide-react": "^1.72.0",
		"plotly.js-dist-min": "^2.35.2",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.1.17",
		"tw-animate-css": "^1.4.0"
	}
}
