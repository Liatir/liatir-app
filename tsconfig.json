{
    "compilerOptions": {
      "target": "ES2021",
      "lib": ["DOM", "ES2021"],
      "module": "NodeNext", // important
      "moduleResolution": "nodenext",
      "strict": true,
      "skipLibCheck": true,
      "declaration": false,
      "sourceMap": false,
      "rootDir": "src-ts",
      "types": ["node"]
    },
	"include": ["src-ts"],
	"exclude": ["node_modules", "src-tauri/tsc", "**/*.test.ts"]
  }