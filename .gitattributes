# Auto detect text files and perform LF normalization
* text=auto

# Executable scripts must keep LF even on a Windows checkout. Two concrete breakages otherwise:
# the self-hosted runner launcher is executed under WSL, where a CRLF interpreter line fails; and
# vite-node cannot transform a shebang followed by CRLF, which makes the unit suite unrunnable.
*.sh text eol=lf
*.mjs text eol=lf

# Workflows must keep LF: the CI guard tests anchor on "\n  <job>:\n", which CRLF silently turns
# into a no-match, leaving the assertions vacuously scanning the wrong slice.
*.yml text eol=lf
*.yaml text eol=lf

# Runtime Box locks and legal inputs are byte-pinned and must not be rewritten by Git for Windows.
runtime-boxes/recipes/**/requirements.lock text eol=lf
runtime-boxes/recipes/**/pixi.lock text eol=lf
runtime-boxes/recipes/**/pixi.toml text eol=lf
runtime-boxes/scrolls/**/pixi.lock text eol=lf
runtime-boxes/scrolls/**/pixi.toml text eol=lf
# Scroll payload files are hashed into the signed box, so a CRLF checkout would break the pin
# before the build ever runs. OpenMM ships a self-test, a startup hook and its `.pth` this way.
runtime-boxes/scrolls/**/*.py text eol=lf
runtime-boxes/scrolls/**/*.pth text eol=lf
runtime-boxes/fixtures/** text eol=lf
runtime-boxes/legal/** text eol=lf
# The Native Tools box pins both of its authoring inputs the same way, and they live outside
# `scrolls/`. A CRLF checkout fails the build at "Local box file SHA-256 mismatch", after the
# multi-gigabyte environment has already been solved and packed.
runtime-boxes/native-tools/** text eol=lf

# A scroll is the document a box's identity is derived from, and a measurement record is retained
# evidence. Both are compared and hashed across machines, so they must read identically on all of
# them rather than however the checkout platform spells a line break.
runtime-boxes/scrolls/**/*.json text eol=lf
runtime-boxes/measurements/** text eol=lf

# Each of these embeds the exact Python a product runner executes, and a scientific validator
# records the SHA-256 of that extracted text as evidence. Left to `text=auto` the same runner hashes
# one way on a Windows checkout and another on Linux CI, so one evidence record could never be
# reconciled with another.
frontend/src/lib/tools/**/python-scripts/*.ts text eol=lf
