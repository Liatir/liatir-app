# Auto detect text files and perform LF normalization
* text=auto

# Executable scripts must keep LF even on a Windows checkout. Two concrete breakages otherwise:
# the self-hosted runner launcher is executed under WSL, where a CRLF interpreter line fails; and
# vite-node cannot transform a shebang followed by CRLF, which makes the unit suite unrunnable.
*.sh text eol=lf
*.mjs text eol=lf

# Workflows must keep LF: the CI guard tests anchor on "\n  <job>:\n", which CRLF silently turns
# into a no-match, leaving the assertions vacuously scanning the wrong slice.
*.yml text eol=lf
*.yaml text eol=lf

# The Native Tools lock is byte-pinned twice over. Its sha256 names the directory the bundled
# environment unpacks into, so a CRLF checkout would build an archive whose identity disagrees with
# the one Linux and macOS build from the same lock; and the build script finds a platform by an
# exact "      linux-64:" line, which a trailing CR turns into "no linux-64 environment".
native-tools-env/pixi.lock text eol=lf
native-tools-env/pixi.toml text eol=lf

# Runtime Box locks and legal inputs are byte-pinned and must not be rewritten by Git for Windows.
runtime-boxes/recipes/**/requirements.lock text eol=lf
runtime-boxes/recipes/**/pixi.lock text eol=lf
runtime-boxes/recipes/**/pixi.toml text eol=lf
runtime-boxes/scrolls/**/pixi.lock text eol=lf
runtime-boxes/scrolls/**/pixi.toml text eol=lf
runtime-boxes/fixtures/** text eol=lf
runtime-boxes/legal/** text eol=lf
