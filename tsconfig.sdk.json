{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "ES2021"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],

    "declaration": true,
    "sourceMap": false,

    "outDir": "sdk/dist-sdk",
    "rootDir": "src-ts",
  },
  "include": [
    "src-ts/sdk/**/*",
    "src-ts/globals.d.ts",
    "src-ts/modules/rs/**/*"
  ]
}