{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "src-ts",
    "outDir": "packages/liatir-api/src/browser-api",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "noEmitOnError": false
  },
  "include": [
    "src-ts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}