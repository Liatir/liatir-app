{
  "productName": "%%APP_NAME%%",
  "identifier": "%%APP_IDENTIFIER%%",
  "version": "%%APP_VERSION%%",

  "build": {
    "frontendDist": "../frontend/dist",
    "removeUnusedCommands": true
  },

  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["local"],
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' asset: http://asset.localhost http: https: blob: data:; media-src 'self' asset: http: https: blob: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    },
    "windows": []
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "resources": {
      "resources/native-tools": "native-tools",
      "resources/demo-files": "demo-files"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {},
    "deep-link": {
      "desktop": {
        "schemes": [
          "liatir"
        ]
      }
    }
  }
}
