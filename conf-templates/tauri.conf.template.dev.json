{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offlab dev",
  "version": "0.0.1",
  "identifier": "app.offlab.app",
  "plugins": {
    "updater": {
      "active": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "offlab"
        ]
      }
    }
  },
  "build": {
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "remote"
      ],
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
