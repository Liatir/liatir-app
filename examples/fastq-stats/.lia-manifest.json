{
  "name": "fastq-stats",
  "version": "1.0.0",
  "description": "Count reads, bases, average length and GC% of a FASTQ file. Node module — has the full Liatir bridge.",
  "runtime": "node",
  "inputSchema": {
    "fastqFile": { "type": "file", "label": "FASTQ file", "required": true, "accept": ["fastq", "fq"] }
  },
  "outputSchema": {
    "reads": { "type": "number", "label": "Reads" },
    "bases": { "type": "number", "label": "Bases" },
    "avgLength": { "type": "number", "label": "Avg length" },
    "gcPercent": { "type": "number", "label": "GC %" },
    "reportPath": { "type": "string", "label": "Report" }
  }
}
