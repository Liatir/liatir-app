{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liatir",
  "version": "0.2.1",
  "identifier": "app.liatir.app",
  "plugins": {
    "updater": {
      "active": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "liatir"
        ]
      }
    }
  },
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "local",
        "local-dev"
      ],
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "lia"
        ],
        "name": "Liatir Module",
        "description": "Liatir .lia plugin",
        "mimeType": "application/x-liatir",
        "role": "Editor"
      }
    ]
  }
}
