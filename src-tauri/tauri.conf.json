{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liatir",
  "version": "1.0.0",
  "identifier": "app.liatir.app",
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "liatir"
        ]
      }
    }
  },
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:38173",
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "local",
        "local-dev"
      ],
      "csp": "script-src 'self' blob:; frame-src 'self' blob: data:"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "lia"
        ],
        "name": "Liatir Module",
        "description": "Liatir .lia module",
        "mimeType": "application/x-liatir",
        "role": "Editor"
      }
    ]
  }
}
